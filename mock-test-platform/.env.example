# Mock Test Platform — environment variables
# Copy to .env and fill in values. .env is gitignored.
#
# Usage:
#   cp .env.example .env
#   # fill in values
#   node scripts/setup.js    ← one-time infra setup (creates KV, R2, SSM params)
#   node scripts/deploy.js   ← deploy workers + Lambda + migrate + seed

# ── Cloudflare ─────────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=
CF_API_TOKEN=           # needs Workers/KV/R2 write permissions

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_PROFILE=default     # or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# ── Secrets ────────────────────────────────────────────────────────────────────
JWT_SECRET=             # min 32 chars, random — shared by all CF Workers
RDS_HOST=               # RDS endpoint (set after first SAM deploy)
RDS_PASSWORD=           # RDS app user password

# ── Optional overrides ─────────────────────────────────────────────────────────
RDS_PORT=5432
RDS_DB=mocktest
RDS_USER=app
R2_BUCKET=mtp-exam-data
SAM_STACK=mock-test-platform
SAM_REGION=ap-south-1
