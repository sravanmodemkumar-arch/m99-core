{
  "name": "mock-test-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:auth":    "wrangler dev --config modules/auth/wrangler.toml --local --port 8787 --inspector-port 9229",
    "dev:exam":    "wrangler dev --config modules/exam-engine/backend/wrangler.toml --local --port 8788 --inspector-port 9230",
    "dev:admin":   "wrangler dev --config modules/admin/backend/wrangler.toml --local --port 8789 --inspector-port 9231",
    "dev:user":    "wrangler dev --config modules/user/wrangler.toml --local --port 8790 --inspector-port 9232",
    "dev:server":  "node scripts/devserver.js",
    "dev":         "concurrently -n auth,exam,admin,user,web -c cyan,magenta,yellow,blue,green \"npm run dev:auth\" \"npm run dev:exam\" \"npm run dev:admin\" \"npm run dev:user\" \"npm run dev:server\"",
    "seed:dev":    "node scripts/seed-admin.js --env dev",
    "seed:r2":     "node scripts/seed-r2-local.js",
    "test":        "cd tests && npx vitest run",
    "test:unit":   "cd tests && npx vitest run --config vitest.config.unit.ts",
    "test:int":    "cd tests && npx vitest run --config vitest.config.integration.ts",
    "setup":       "node scripts/setup.js",
    "deploy":      "node scripts/deploy.js",
    "deploy:cf":   "node scripts/deploy.js --step cf",
    "deploy:sam":  "node scripts/deploy.js --step sam",
    "deploy:db":   "node scripts/deploy.js --step db",
    "deploy:seed": "node scripts/deploy.js --step seed",
    "deploy:cdn":  "node scripts/deploy.js --step cdn"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wrangler": "^3.96.0"
  }
}
