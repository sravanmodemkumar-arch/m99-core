# Cloudflare Workers local dev secrets — copy to .dev.vars and fill in values
# Used by: wrangler dev
# Production: wrangler secret put <KEY>

# No worker-level secrets in rrb-group-d v1.
# JWT verification is done via KV lookup (jwt:{hash} key written by auth worker).
# KV bindings are configured in wrangler.toml.
#
# If you add direct JWT verification here in future, add:
# JWT_SECRET=same-value-as-auth-worker
