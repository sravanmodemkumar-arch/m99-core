{
  "expo": {
    "name": "Exam Engine",
    "slug": "exam-engine",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1565c0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.examengine.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1565c0"
      },
      "package": "com.examengine.mobile",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-screen-orientation", { "initialOrientation": "DEFAULT" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
