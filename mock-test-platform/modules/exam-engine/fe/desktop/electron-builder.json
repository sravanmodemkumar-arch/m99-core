{
  "appId": "com.examengine.desktop",
  "productName": "Exam Engine",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "server.js",
    "sync.js",
    "preload.js",
    "app-config.json",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false
  }
}
