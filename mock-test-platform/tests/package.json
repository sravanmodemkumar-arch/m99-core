{
  "name": "mock-test-platform-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit":        "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:web":         "playwright test --config e2e/web/playwright.config.ts",
    "test:desktop":     "playwright test --config e2e/desktop/playwright.config.ts",
    "test:mobile":      "maestro test e2e/mobile",
    "test:all":         "npm run test:unit && npm run test:integration && npm run test:web"
  },
  "devDependencies": {
    "vitest":                          "^1.6.0",
    "@vitest/coverage-v8":             "^1.6.0",
    "@playwright/test":                "^1.44.0",
    "typescript":                      "^5.4.0"
  }
}
