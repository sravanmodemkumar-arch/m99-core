# AWS Lambda local dev environment — copy to .env and fill in values
# Used by: sam local invoke / pytest with python-dotenv
# Production: AWS SSM Parameter Store or sam deploy --parameter-overrides

# ── Database (RDS PostgreSQL) ──────────────────────────────────────────────────
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB=mocktest
RDS_USER=app
RDS_PASSWORD=change-me

# ── JWT — must match auth worker JWT_SECRET exactly ───────────────────────────
JWT_SECRET=change-me-min-32-chars-random-string
JWT_EXPIRY_HOURS=24

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_BUCKET=mock-test-content

# ── Tuning (safe defaults — override per environment) ─────────────────────────
EPS_CHUNK_SIZE=100
BATCH_SIZE=4
FLUSH_HOURS=24
TGM_MIN_TENANTS=20
TGM_USER_THRESHOLD=50000
